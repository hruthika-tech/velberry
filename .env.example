# ───────────── Velberry environment ─────────────
# Copy this file to `.env` and fill in values. NEVER commit `.env`.

PORT=3000
NODE_ENV=development
# Public URL of the site (used in emails, payment callbacks and tracking links)
APP_URL=http://localhost:3000
# Long random string used to sign cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ───────────── Database: Supabase PostgreSQL (required) ─────────────
# Supabase → your project → Connect (top bar) → "Session pooler" connection string (works on IPv4 networks).
# Use the SESSION pooler (port 5432) or the Direct connection — NOT the Transaction pooler (port 6543):
# the server relies on session-level advisory locks.
# Replace [YOUR-PASSWORD] with the database password (URL-encode special characters, e.g. @ → %40).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# TLS: "require" (default for remote hosts: encrypted) · "verify" (encrypted + certificate check, needs DATABASE_CA_CERT) · "disable" (local only)
DATABASE_SSL=require
# Path to the CA certificate from Supabase → Project Settings → Database → SSL Configuration (only for DATABASE_SSL=verify)
DATABASE_CA_CERT=
# Max connections per server instance. Long-running server: 10. On Vercel (default there: 2) every instance opens
# its own pool, so keep it at 2. Stay on the SESSION pooler (port 5432): the per-order locks need session mode.
DB_POOL_MAX=10

# ───────────── Image storage: Supabase Storage (required in production) ─────────────
# Supabase → Project Settings → API Keys. Project URL is on Project Settings → Data API.
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET key (sb_secret_… or legacy service_role JWT). SERVER ONLY — never put it in browser code or share it.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_… or legacy anon). Optional — only used by `npm run setup-storage`
# to prove the public key can NOT upload. The shop's browser code never needs it.
SUPABASE_ANON_KEY=
# Bucket names (defaults shown; created by `npm run setup-storage`)
SUPABASE_BUCKET_PRODUCTS=product-images
SUPABASE_BUCKET_360=product-360
SUPABASE_BUCKET_CATEGORIES=category-images

# Original SQLite database, read (never modified) by `npm run migrate:sqlite`
SQLITE_FILE=data/velberry.db

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@velberry.local
ADMIN_PASSWORD=change-this-password

# ───────────── Payments ─────────────
# razorpay = real Razorpay Checkout · mock = local payment simulator (development only; refused in production)
# If razorpay is chosen but anything below is missing or mismatched, payments are DISABLED with a clear
# reason (the server refuses to start in production). It never silently falls back to the simulator.
PAYMENT_PROVIDER=razorpay
# test (default) or live. The keys must match: rzp_test_… for test, rzp_live_… for live.
RAZORPAY_MODE=test
# Razorpay Dashboard (in the same Test/Live mode) → Account & Settings → API Keys.
# The Key ID is public (Checkout needs it). The Key Secret is SERVER-ONLY.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → the secret you type when creating the webhook. SERVER-ONLY.
# Required in live mode.
RAZORPAY_WEBHOOK_SECRET=
# Only used when PAYMENT_PROVIDER is not set: allows the local simulator when no Razorpay keys are present.
ALLOW_MOCK_PAYMENTS=false

# ───────────── Shiprocket (shipping) ─────────────
# Create an API user: Shiprocket → Settings → API → Configure → Create API User
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact "Pickup Location" nickname from Shiprocket → Settings → Pickup Addresses (case-sensitive)
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional fallback only: the PIN registered for that pickup location in Shiprocket is used for rates
PICKUP_PINCODE=
# Token you choose; set it as the "x-api-key" header for Shiprocket's tracking webhook
SHIPROCKET_WEBHOOK_TOKEN=
# Shiprocket has no test mode — every booking is real and charged to your wallet. Booking (create order,
# AWB, pickup, label, cancel) is OFF outside production unless this is true. Rates and tracking always work.
SHIPROCKET_ALLOW_BOOKING=false

# Parcel used for courier rates and bookings: your standard box (cm) + packing material (g).
# Each charm's own weight (Admin → product → weight) is added on top.
SHIP_BOX_LENGTH_CM=12
SHIP_BOX_BREADTH_CM=10
SHIP_BOX_HEIGHT_CM=6
SHIP_PACKAGING_GRAMS=50

# Flat-rate fallback used when Shiprocket is not configured (rupees)
# flat = always charge SHIPPING_FLAT_RATE; courier = charge the Shiprocket rate quoted for the PIN code
SHIPPING_FEE_MODE=flat
SHIPPING_FLAT_RATE=79
FREE_SHIPPING_ABOVE=999

# ───────────── Email (Resend) ─────────────
# https://resend.com → API Keys. Domain must be verified to send from it.
RESEND_API_KEY=
EMAIL_FROM=Velberry <hello@yourdomain.com>
# Where new-order alerts for the shop owner go
SHOP_OWNER_EMAIL=
# Without RESEND_API_KEY nothing is sent: emails are listed in Admin → Emails as "logged" with a Preview link.

# ───────────── Scheduled jobs (Vercel) ─────────────
# Long random token. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
# Not needed for `npm start` (the server runs the jobs on its own timers). Without it the cron endpoints are off.
CRON_SECRET=
# Release expired checkouts when a new checkout starts (max once per 5 min). Default: on for Vercel, off otherwise.
# CHECKOUT_EXPIRY_ON_REQUEST=true
