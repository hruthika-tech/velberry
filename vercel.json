{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{supabase/migrations,server/pages}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/share/product/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/shop",
      "destination": "/api/index"
    },
    {
      "source": "/shop.html",
      "destination": "/api/index"
    },
    {
      "source": "/cart",
      "destination": "/api/index"
    },
    {
      "source": "/cart.html",
      "destination": "/api/index"
    },
    {
      "source": "/checkout",
      "destination": "/api/index"
    },
    {
      "source": "/checkout.html",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:page([a-z0-9-]+)",
      "destination": "/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.razorpay.com https://*.supabase.co; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/all",
      "schedule": "30 21 * * *"
    }
  ]
}
